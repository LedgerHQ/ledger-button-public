{
  "name": "@ledgerhq/ledger-wallet-provider-docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next build && pagefind --site .next/server/app --output-path public/_pagefind",
        "cwd": "{projectRoot}"
      },
      "inputs": ["default", "^production", { "externalDependencies": ["next", "pagefind"] }],
      "outputs": ["{projectRoot}/.next", "{projectRoot}/public/_pagefind"],
      "dependsOn": ["^build"],
      "cache": true
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next dev --port 0",
        "cwd": "{projectRoot}"
      },
      "continuous": true,
      "dependsOn": ["^build"],
      "cache": false
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next start --port 0",
        "cwd": "{projectRoot}"
      },
      "continuous": true,
      "dependsOn": ["build"]
    },
    "serve-static": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next start --port 0",
        "cwd": "{projectRoot}"
      },
      "continuous": true,
      "dependsOn": ["build"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "default",
        "^default",
        "{projectRoot}/tsconfig.json",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "dependsOn": ["^build"],
      "cache": true
    }
  }
}
